<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.school.controllers.StudentsController" spacing="10" style="-fx-padding: 10;">

    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
        <Label text="Search Student:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="searchField" promptText="Type name or email..." prefWidth="300"/>
    </HBox>

    <TableView fx:id="studentTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFirstName" text="First Name" prefWidth="150"/>
            <TableColumn fx:id="colLastName" text="Last Name" prefWidth="150"/>
            <TableColumn fx:id="colClassName" text="Class" prefWidth="100"/>
        </columns>
    </TableView>
    <GridPane hgap="10" vgap="10">
        <TextField fx:id="firstNameField" promptText="First Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="lastNameField" promptText="Last Name" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <TextField fx:id="emailField" promptText="Email" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" promptText="Phone" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <TextField fx:id="dobField" promptText="DOB (YYYY-MM-DD)" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <ChoiceBox fx:id="classChoice" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Add" onAction="#handleAdd"/>
        <Button text="Update" onAction="#handleUpdate"/>
        <Button text="Delete" onAction="#handleDelete"/>
        <Button text="Clear" onAction="#handleClear"/>
        <Button text="Transfer Class" onAction="#handleTransfer" style="-fx-background-color: #e67e22;"/>

        <Button text="Clear" onAction="#handleClear"/>
    </HBox>
</VBox>