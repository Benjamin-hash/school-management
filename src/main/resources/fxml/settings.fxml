<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.school.controllers.SettingsController" spacing="15" style="-fx-padding: 20;">

    <Label text="Global School Settings" styleClass="module-title"/>
    <Label text="Set the active Academic Year and Term. This affects all Grade and Attendance entry." styleClass="module-note"/>

    <GridPane hgap="10" vgap="15">
        <Label text="Academic Year:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="yearField" promptText="e.g. 2026/2027" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="150"/>

        <Label text="Current Term:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ChoiceBox fx:id="termChoice" GridPane.rowIndex="1" GridPane.columnIndex="1" prefWidth="150"/>
    </GridPane>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="Save Settings" onAction="#handleSave" style="-fx-background-color: #3498db;"/>
        <Label fx:id="msgLabel"/>
    </HBox>

    <!-- NEW BACKUP SECTION -->
    <Separator style="-fx-padding: 10 0 0 0;"/>

    <Label text="Data Management" styleClass="module-title" style="-fx-font-size: 18px;"/>
    <Label text="It is highly recommended to backup your database at the end of every term." styleClass="module-note"/>
    <Button text="Backup Database" onAction="#handleBackup" style="-fx-background-color: #27ae60; -fx-padding: 10 20 10 20;"/>

</VBox>