<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.school.controllers.DashboardController"
            stylesheets="@../css/custom.css" styleClass="root" style="-fx-background-color: #f4f7f6;">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-padding: 15 25 15 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 10, 0, 0, 2);">
            <Label text="Greenfield High School" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #1e293b;"/>
            <Pane HBox.hgrow="ALWAYS"/>

            <!-- User Profile Area -->
            <HBox alignment="CENTER" spacing="10">
                <Label fx:id="welcomeLabel" style="-fx-font-weight: bold; -fx-text-fill: #475569;"/>
                <Button text="Logout" onAction="#handleLogout"
                        style="-fx-background-color: #fee2e2; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
            </HBox>
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <!-- SIDEBAR -->
    <left>
        <ScrollPane fitToWidth="true" style="-fx-background-color: white; -fx-border-color: transparent #e2e8f0 transparent transparent; -fx-border-width: 0 1 0 0;" minWidth="220" maxWidth="220">
            <VBox fx:id="menuBox" spacing="5" style="-fx-background-color: white; -fx-padding: 20 15 20 15;">
                <!-- Menu items will be injected here by DashboardController -->
            </VBox>
        </ScrollPane>
    </left>

    <!-- MAIN CONTENT AREA -->
    <center>
        <BorderPane fx:id="contentArea" style="-fx-padding: 25;">
            <!-- Floating Card Effect -->
            <style>
                /* This makes the center content look like a floating sheet of paper */
            </style>
        </BorderPane>
    </center>
</BorderPane>