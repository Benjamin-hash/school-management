<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.school.controllers.ClassController" spacing="10" style="-fx-padding: 10;">
    <Label text="Class Management" styleClass="module-title"/>
    <TableView fx:id="classTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Class Name" prefWidth="130"/>
            <TableColumn fx:id="colLevel" text="Level" prefWidth="100"/>
            <TableColumn fx:id="colSection" text="Section" prefWidth="90"/>
            <TableColumn fx:id="colOrder" text="Order" prefWidth="80"/>
            <TableColumn fx:id="colCount" text="Students" prefWidth="100"/>
        </columns>
    </TableView>
    <GridPane hgap="10" vgap="10">
        <TextField fx:id="nameField" promptText="Name (e.g. JHS 1C)" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="levelField" promptText="Level (e.g. JHS 1)" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <TextField fx:id="sectionField" promptText="Section (e.g. C)" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
        <TextField fx:id="orderField" promptText="Order (e.g. 1)" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
        <Label text="Homeroom Teacher:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ChoiceBox fx:id="homeroomChoice" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3" prefWidth="300"/>
    </GridPane>
    <HBox spacing="10">
        <Button text="Add Class" onAction="#handleAdd"/>
        <Button text="Update Class" onAction="#handleUpdate"/>
        <Button text="Clear" onAction="#handleClear"/>
    </HBox>
</VBox>