<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.school.controllers.SubjectController" spacing="10" style="-fx-padding: 10;">
    <Label text="Subject Management" styleClass="module-title"/>
    <TableView fx:id="subjectTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Subject Name" prefWidth="300"/>
        </columns>
    </TableView>
    <HBox spacing="10">
        <TextField fx:id="nameField" promptText="Subject Name (e.g., Mathematics)"/>
        <Button text="Add Subject" onAction="#handleAdd"/>
    </HBox>
</VBox>