<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.school.controllers.TeacherController" spacing="10" style="-fx-padding: 10;">
    <Label text="Teacher Management" styleClass="module-title"/>
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 10 0;">
        <Label text="Search Teacher:" style="-fx-font-weight: bold;"/>
        <TextField fx:id="searchField" promptText="Type name or email..." prefWidth="300"/>
    </HBox>
    <TableView fx:id="teacherTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFirst" text="First Name" prefWidth="120"/>
            <TableColumn fx:id="colLast" text="Last Name" prefWidth="120"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200"/>
        </columns>
    </TableView>
    <GridPane hgap="10" vgap="10">
        <TextField fx:id="fnField" promptText="First Name" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="lnField" promptText="Last Name" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <TextField fx:id="emailField" promptText="Email" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" promptText="Phone" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <TextField fx:id="userField" promptText="Login Username" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="passField" promptText="Login Password" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="Add Teacher &amp; Create Login" onAction="#handleAdd" style="-fx-background-color: #3b82f6; -fx-text-fill: white;"/>
        <Button text="Update Teacher" onAction="#handleUpdate" style="-fx-background-color: #f39c12; -fx-text-fill: white;"/>
        <Button text="Delete Teacher" onAction="#handleDelete" style="-fx-background-color: #ef4444; -fx-text-fill: white;"/>
        <Button text="Clear Form" onAction="#handleClear"/>
        <Label fx:id="msgLabel" style="-fx-font-weight: bold;"/>
    </HBox>
</VBox>