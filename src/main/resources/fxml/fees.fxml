<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.school.controllers.FeeController" spacing="15" style="-fx-padding: 20;">

    <Label text="Fee Management" styleClass="module-title"/>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Class:"/>
        <ChoiceBox fx:id="classChoice" prefWidth="150"/>
        <Label fx:id="activeSessionLabel" style="-fx-font-weight: bold; -fx-text-fill: #3498db;"/>
    </HBox>

    <TableView fx:id="feeTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Student Name" prefWidth="250"/>
            <TableColumn fx:id="colDue" text="Amount Due" prefWidth="120"/>
            <TableColumn fx:id="colPaid" text="Amount Paid" prefWidth="120"/>
            <TableColumn fx:id="colBalance" text="Balance" prefWidth="120"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="Generate Term Bills" onAction="#handleGenerateBills" style="-fx-background-color: #f39c12; -fx-padding: 10 20;"/>
        <Button text="Record Payment" onAction="#handleRecordPayment" style="-fx-background-color: #27ae60; -fx-padding: 10 20;"/>
        <Label fx:id="msgLabel" style="-fx-font-weight: bold;"/>
    </HBox>
</VBox>