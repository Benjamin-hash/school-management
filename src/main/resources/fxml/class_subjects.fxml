<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.school.controllers.ClassSubjectController" spacing="10" style="-fx-padding: 10;">
    <Label text="Class &amp; Subject Assignments" styleClass="module-title"/>
    <TableView fx:id="mapTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colClass" text="Class" prefWidth="150"/>
            <TableColumn fx:id="colSubject" text="Subject" prefWidth="150"/>
            <TableColumn fx:id="colTeacher" text="Teacher" prefWidth="200"/>
        </columns>
    </TableView>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <ChoiceBox fx:id="classChoice"/>
        <ChoiceBox fx:id="subjectChoice"/>
        <ChoiceBox fx:id="teacherChoice"/>
        <Button text="Assign" onAction="#handleAssign"/>
    </HBox>
</VBox>