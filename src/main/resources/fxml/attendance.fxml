<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.school.controllers.AttendanceController" spacing="10" style="-fx-padding: 10;">

    <Label text="Daily Attendance" styleClass="module-title"/>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Label text="Class:"/>
        <ChoiceBox fx:id="classChoice" prefWidth="150"/>
        <Label text="Date:"/>
        <DatePicker fx:id="datePicker"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 5 0 5 0;">
        <Label text="Quick Actions:" style="-fx-font-weight: bold;"/>
        <Button text="Mark All Present" onAction="#handleMarkAllPresent" style="-fx-background-color: #10b981; -fx-font-size: 12px;"/>
        <Button text="Mark All Absent" onAction="#handleMarkAllAbsent" style="-fx-background-color: #ef4444; -fx-font-size: 12px;"/>
    </HBox>
    <HBox spacing="20" alignment="CENTER_RIGHT" style="-fx-padding: 10 0 0 0;">
        <Label fx:id="totalPresentLabel" text="Present: 0" style="-fx-text-fill: #166534; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        <Label fx:id="totalAbsentLabel" text="Absent: 0" style="-fx-text-fill: #991b1b; -fx-font-weight: bold; -fx-font-size: 14px;"/>
        <Label fx:id="totalLateLabel" text="Late: 0" style="-fx-text-fill: #854d0e; -fx-font-weight: bold; -fx-font-size: 14px;"/>
    </HBox>

    <TableView fx:id="attendanceTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colName" text="Student Name" prefWidth="250"/>
            <TableColumn fx:id="colStatus" text="Status" prefWidth="150"/>
        </columns>
    </TableView>

    <HBox spacing="15" alignment="CENTER_LEFT">
        <Button text="Save Attendance" onAction="#handleSave" style="-fx-background-color: #27ae60;"/>
        <Label fx:id="msgLabel" style="-fx-text-fill: #27ae60; -fx-font-weight: bold;"/>
    </HBox>
</VBox>